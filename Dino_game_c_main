#define F_CPU 14745600UL
#include <avr/io.h>
#include <util/delay.h>
#include <stdlib.h>
#include <stdio.h>

// ---------------- LCD Macros ---------------- //
#define RS 0
#define RW 1
#define EN 2
#define lcd_port PORTC
#define sbit(reg, bit) reg |= (1 << bit)
#define cbit(reg, bit) reg &= ~(1 << bit)

// ---------------- Pins ---------------- //
#define JUMP_BUTTON PE7

// ---------------- Dino & Cactus Characters ---------------- //
uint8_t dino[8] = {
	0b00100,
	0b01110,
	0b10101,
	0b00100,
	0b01010,
	0b10001,
	0b00000,
0b00000};

uint8_t cactus[8] = {
	0b00100,
	0b00100,
	0b00101,
	0b10101,
	0b11111,
	0b00100,
	0b00100,
0b00100};

// ---------------- LCD Functions ---------------- //
void lcd_port_config(void)
{
	DDRC |= 0xFF;
	PORTC = 0x00;
}

void lcd_set_4bit(void)
{
	_delay_ms(1);
	for (int i = 0; i < 3; i++)
	{
		cbit(lcd_port, RS);
		cbit(lcd_port, RW);
		lcd_port = 0x30;
		sbit(lcd_port, EN);
		_delay_ms(5);
		cbit(lcd_port, EN);
	}
	cbit(lcd_port, RS);
	cbit(lcd_port, RW);
	lcd_port = 0x20;
	sbit(lcd_port, EN);
	_delay_ms(5);
	cbit(lcd_port, EN);
}

void lcd_wr_command(unsigned char cmd)
{
	unsigned char temp = cmd & 0xF0;
	lcd_port = (lcd_port & 0x0F) | temp;
	cbit(lcd_port, RS);
	cbit(lcd_port, RW);
	sbit(lcd_port, EN);
	_delay_ms(2);
	cbit(lcd_port, EN);

	temp = (cmd & 0x0F) << 4;
	lcd_port = (lcd_port & 0x0F) | temp;
	cbit(lcd_port, RS);
	cbit(lcd_port, RW);
	sbit(lcd_port, EN);
	_delay_ms(2);
	cbit(lcd_port, EN);
}

void lcd_wr_char(char data)
{
	char temp = data & 0xF0;
	lcd_port = (lcd_port & 0x0F) | temp;
	sbit(lcd_port, RS);
	cbit(lcd_port, RW);
	sbit(lcd_port, EN);
	_delay_ms(2);
	cbit(lcd_port, EN);

	temp = (data & 0x0F) << 4;
	lcd_port = (lcd_port & 0x0F) | temp;
	sbit(lcd_port, RS);
	cbit(lcd_port, RW);
	sbit(lcd_port, EN);
	_delay_ms(2);
	cbit(lcd_port, EN);
}

void lcd_init(void)
{
	lcd_set_4bit();
	_delay_ms(1);
	lcd_wr_command(0x28);
	lcd_wr_command(0x01);
	lcd_wr_command(0x06);
	lcd_wr_command(0x0C);
	lcd_wr_command(0x80);
}

void lcd_cursor(char row, char column)
{
	switch (row)
	{
		case 1:
		lcd_wr_command(0x80 + column - 1);
		break;
		case 2:
		lcd_wr_command(0xC0 + column - 1);
		break;
	}
}

void lcd_string(char row, char column, char *str)
{
	lcd_cursor(row, column);
	while (*str != '\0')
	{
		lcd_wr_char(*str);
		str++;
	}
}

void lcd_create_char(unsigned char loc, uint8_t *charmap)
{
	loc &= 0x07;
	lcd_wr_command(0x40 + (loc * 8));
	for (int i = 0; i < 8; i++)
	{
		lcd_wr_char(charmap[i]);
	}
}

// ---------------- Dino Game ---------------- //
int main(void)
{
	// LCD init
	lcd_port_config();
	lcd_init();

	// Button setup
	PORTE &= ~(1 << JUMP_BUTTON); // enable pull-up
	DDRE &= ~(1 << JUMP_BUTTON);  // input

	// Load custom chars
	lcd_create_char(0, dino);
	lcd_create_char(1, cactus);

	lcd_string(1, 1, " Dino Game! ");
	_delay_ms(1000);
	lcd_wr_command(0x01);

	int dino_row = 2;
	int cactus_pos = 16;
	int game_over = 0;
	int score = 0;

	char buffer[16];

	int prev_dino_row = 2;
	int prev_cactus_pos = 16;

	while (!game_over)
	{
		// --- Update Score (top-right corner) ---
		sprintf(buffer, "S:%d", score);
		lcd_string(1, 12, buffer);

		// --- Erase old Dino ---
		lcd_cursor(prev_dino_row, 2);
		lcd_wr_char(' ');

		// --- Erase old Cactus ---
		if (prev_cactus_pos > 0)
		{
			lcd_cursor(2, prev_cactus_pos);
			lcd_wr_char(' ');
		}

		// --- Check Jump Button ---
		if (!(PINE & (1 << JUMP_BUTTON)))
		dino_row = 1;
		else
		dino_row = 2;

		// --- Draw Dino ---
		lcd_cursor(dino_row, 2);
		lcd_wr_char(0);

		// --- Draw Cactus ---
		if (cactus_pos > 0)
		{
			lcd_cursor(2, cactus_pos);
			lcd_wr_char(1);
			cactus_pos--;
		}
		else
		{
			cactus_pos = 16;  // reset cactus
			score++;          // increment score
		}

		// --- Collision detection ---
		if (cactus_pos == 2 && dino_row == 2)
		{
			lcd_wr_command(0x01);
			lcd_string(1, 3, "GAME OVER!");
			sprintf(buffer, "Score:%d", score);
			lcd_string(2, 6, buffer);
			game_over = 1;
			break;
		}

		// --- Save old positions ---
		prev_dino_row = dino_row;
		prev_cactus_pos = cactus_pos + 1; // since we decremented

		_delay_ms(300);
	}

	while (1);
}

 

